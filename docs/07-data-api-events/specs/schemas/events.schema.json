{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwa-poc.local/schemas/events.schema.json",
  "title": "Korean Equity RWA PoC Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "recordedAt",
    "producer",
    "workflowId",
    "correlationId",
    "causationId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "data"
  ],
  "properties": {
    "eventId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "eventType": {
      "type": "string",
      "enum": [
        "workflow.command.accepted.v1",
        "workflow.command.rejected.v1",
        "workflow.state.changed.v1",
        "workflow.correction.recorded.v1",
        "workflow.quarantined.v1",
        "disclosure.consent-recorded.v1",
        "complaint.submitted.v1",
        "complaint.assigned.v1",
        "complaint.processing-started.v1",
        "complaint.response-recorded.v1",
        "complaint.correction-linked.v1",
        "complaint.closed.v1",
        "primary.order.submitted.v1",
        "primary.execution.recorded.v1",
        "primary.execution.corrected.v1",
        "primary.allocation.completed.v1",
        "primary.execution-allocation.confirmed.v1",
        "primary.risk.approved.v1",
        "rights.entry.approved.v1",
        "rights.entry.completed.v1",
        "token.mint.confirmed.v1",
        "domestic.settlement.confirmed.v1",
        "custody.position.confirmed.v1",
        "token.trading-enabled.v1",
        "market-maker.quote.published.v1",
        "market-maker.quote.expired.v1",
        "secondary.order.accepted.v1",
        "secondary.reservation.completed.v1",
        "secondary.chain-settlement.confirmed.v1",
        "secondary.rights-ledger.confirmed.v1",
        "secondary.funds-ledger.confirmed.v1",
        "secondary.trade.completed.v1",
        "market-maker.position.changed.v1",
        "market-maker.hedge.requested.v1",
        "market-maker.hedge.execution-confirmed.v1",
        "market-maker.hedge.domestic-settlement-confirmed.v1",
        "market-maker.hedge.custody-confirmed.v1",
        "market-maker.hedge.usd-paid.v1",
        "redemption.locked.v1",
        "redemption.execution.recorded.v1",
        "redemption.cash-claim.created.v1",
        "token.burn.confirmed.v1",
        "redemption.usd-paid.v1",
        "redemption.completed.v1",
        "dividend.snapshot.recorded.v1",
        "dividend.usd-paid.v1",
        "dividend.usdc-converted.v1",
        "vote.instruction.recorded.v1",
        "vote.execution.recorded.v1",
        "corporate-action.hold-placed.v1",
        "corporate-action.adjustment-approved.v1",
        "regulatory-report.submitted.v1",
        "regulatory-report.corrected.v1",
        "reconciliation.completed.v1",
        "reconciliation.mismatch-detected.v1",
        "hold.placed.v1",
        "hold.release-approved.v1",
        "hold.released.v1",
        "audit.privileged-action-recorded.v1"
      ]
    },
    "schemaVersion": { "const": "1.0.0" },
    "occurredAt": { "$ref": "common.schema.json#/$defs/UtcTimestamp" },
    "recordedAt": { "$ref": "common.schema.json#/$defs/UtcTimestamp" },
    "producer": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "workflowId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "correlationId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "causationId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "aggregateType": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
    "aggregateId": { "$ref": "common.schema.json#/$defs/Uuid" },
    "aggregateVersion": { "type": "integer", "minimum": 1 },
    "sourceSequence": { "type": "integer", "minimum": 1 },
    "sourceMetadata": { "$ref": "common.schema.json#/$defs/SourceMetadata" },
    "keyId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" },
    "data": {
      "type": "object",
      "required": ["simulation"],
      "properties": {
        "simulation": { "const": true },
        "stateAxis": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "previousState": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "newState": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "securityId": { "$ref": "common.schema.json#/$defs/SecurityId" },
        "shareQuantity": { "$ref": "common.schema.json#/$defs/NonNegativeIntegerString" },
        "money": { "$ref": "common.schema.json#/$defs/Money" },
        "transactionHash": { "$ref": "common.schema.json#/$defs/EvidenceHash" },
        "orderId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "quoteId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "tradeId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "rightsEntryId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "settlementId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "custodyConfirmationId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "redemptionId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "reportId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "holdId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "disclosureId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "disclosureVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "complaintId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "complaintType": { "type": "string", "enum": ["PLATFORM_TECHNICAL", "BROKERAGE_ACCOUNT", "TRADE_ERROR", "REGULATORY"] },
        "responsibleInstitutionId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "responseReferenceId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "correctionWorkflowId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "actorId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "fromWallet": { "$ref": "common.schema.json#/$defs/EvmAddress" },
        "toWallet": { "$ref": "common.schema.json#/$defs/EvmAddress" },
        "paymentMode": {
          "type": "string",
          "enum": ["USD_LEDGER", "USDC_CONVERSION", "USDC_ONCHAIN"]
        },
        "evidenceHash": { "$ref": "common.schema.json#/$defs/EvidenceHash" },
        "sourceRecordId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "decision": {
          "type": "string",
          "enum": ["APPROVE", "REJECT", "REQUEST_CORRECTION"]
        },
        "success": { "type": "boolean" },
        "requestedAt": { "$ref": "common.schema.json#/$defs/UtcTimestamp" },
        "completedAt": { "$ref": "common.schema.json#/$defs/UtcTimestamp" },
        "correctsEventId": { "$ref": "common.schema.json#/$defs/Uuid" },
        "reasonKo": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "required": ["sourceSequence"] },
      "then": { "required": ["sourceMetadata", "keyId", "signature"] }
    }
  ]
}
