{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwa-poc.local/schemas/test-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "status", "defaults", "profiles", "groups"],
  "properties": {
    "$schema": { "const": "./test-catalog.schema.json" },
    "schemaVersion": { "const": "2.0.0" },
    "status": { "const": "APPROVED" },
    "defaults": { "type": "object" },
    "profiles": { "type": "object" },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["groupId", "layers", "preconditions", "evidence", "cases"],
        "properties": {
          "groupId": { "type": "string", "minLength": 1 },
          "layers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "preconditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/TestCase" }
          }
        }
      }
    }
  },
  "$defs": {
    "NonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "TestCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "testId", "requirementIds", "layers", "profile", "required", "automated",
        "fixtureRefs", "inputs", "steps", "startStates", "expectedStates", "forbiddenStates",
        "expectedQuantities", "expectedAmounts", "expectedErrors", "recoveryOrQuarantine",
        "resumeConditions", "evidence"
      ],
      "properties": {
        "testId": { "type": "string", "pattern": "^[가-힣A-Za-z0-9]+(?:-[가-힣A-Za-z0-9]+)+-[0-9]{2}$" },
        "requirementIds": { "$ref": "#/$defs/NonEmptyStrings" },
        "layers": { "$ref": "#/$defs/NonEmptyStrings" },
        "profile": { "type": "string", "enum": ["QUICK", "FULL_LOCAL", "FUJI_DEMO"] },
        "required": { "const": true },
        "automated": { "type": "boolean" },
        "fixtureRefs": { "$ref": "#/$defs/NonEmptyStrings" },
        "inputs": { "type": "object", "minProperties": 1 },
        "steps": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "startStates": { "$ref": "#/$defs/NonEmptyStrings" },
        "expectedStates": { "$ref": "#/$defs/NonEmptyStrings" },
        "forbiddenStates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "expectedQuantities": { "type": "object", "minProperties": 1 },
        "expectedAmounts": { "type": "object", "minProperties": 1 },
        "expectedErrors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "recoveryOrQuarantine": { "$ref": "#/$defs/NonEmptyStrings" },
        "resumeConditions": { "$ref": "#/$defs/NonEmptyStrings" },
        "evidence": { "$ref": "#/$defs/NonEmptyStrings" },
        "coveredStateCodes": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }, "uniqueItems": true }
      }
    }
  }
}
