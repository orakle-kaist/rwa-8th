# Docker로 화면을 확인할 때는 이 파일을 .env로 복사할 필요가 없다.
# 아래 값은 컨테이너 밖에서 각 개발 서버를 직접 실행할 때만 참고한다.
# .env를 만들었다면 백엔드는 자동으로 읽지 않으므로 셸에 명시적으로 불러와야 한다.
# 모든 값은 로컬 합성 PoC 전용이며 실제 기관 자격증명이 아니다.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
MOCK_INSTITUTIONS_PORT=4100
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
DATABASE_URL=postgresql://rwa_poc:rwa_poc_local_only@localhost:5432/rwa_poc
ANVIL_RPC_URL=http://localhost:8545
CHAIN_RPC_URL=http://localhost:8545

# 아래 두 값은 Fuji 도구의 선택 설정이다. 로컬 화면 시연에는 필요 없다.
# FUJI_RPC_URL이 비어 있으면 공식 Fuji RPC를 사용한다.
FUJI_RPC_URL=
FUJI_KEYSTORE_DIR=.runtime/fuji/keystores

# 공공데이터 키와 Fuji 키 저장소 비밀번호는 이 파일에 넣지 않는다.
# 필요할 때만 현재 셸에 DATA_GO_KR_SERVICE_KEY와 FUJI_KEYSTORE_PASSWORD를 설정한다.
TEST_CLOCK_MODE=system
TEST_CLOCK_ISO=2026-08-31T00:00:00.000Z
